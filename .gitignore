# 构建产物
TabbedExplorer.exe
TabbedExplorer.new.exe
build.log
build.log.prev
*.pdb
*.user
.vs/
bin/
obj/

# 探针留下的截图 / 记录 / 编译产物（源码 probe/*.py、probe/*.cs 要进库，其余不进）
*.png
!docs/*.png
!assets/*.png
probe/*.log
probe/*.txt
probe/*.exe
__pycache__/

# 本机数据（绿色便携那个 data\ 目录：settings.txt / desktops.txt / log.txt 全在这儿）
data/

# 开发时的项目记忆（.workbuddy\ 是工作区的本地笔记，不进公开仓库）
.workbuddy/

# 本机构建后钩子（个人镜像/部署脚本之类，不进公开仓库）
tools/*.local.bat

# 本机临时
*.tmp

# 宣发物料（B站/少数派/V2EX/酷安的文案与录屏清单，本机自己用，不进公开库）
promo/
